from datetime import datetime, timedelta

# ==============================================================================
# 1. APLICAÇÃO TREINO
# ==============================================================================

class Treino:
    def __init__(self, id: int, data: datetime, distancia: float, tempo: timedelta):
        self.__id = id
        self.__data = data
        self.__distancia = distancia
        self.__tempo = tempo

    # Getters e Setters
    def get_id(self): return self.__id
    def set_id(self, id): self.__id = id

    def get_data(self): return self.__data
    def set_data(self, data): self.__data = data

    def get_distancia(self): return self.__distancia
    def set_distancia(self, distancia): self.__distancia = distancia

    def get_tempo(self): return self.__tempo
    def set_tempo(self, tempo): self.__tempo = tempo

    # Método Pace (Tempo / Distância)
    def pace(self) -> timedelta:
        if self.__distancia <= 0:
            return timedelta(0)
        segundos_totais = self.__tempo.total_seconds()
        pace_segundos = segundos_totais / self.__distancia
        return timedelta(seconds=pace_segundos)

    def __str__(self):
        pace_td = self.pace()
        total_segundos = int(pace_td.total_seconds())
        minutos = total_segundos // 60
        segundos = total_segundos % 60
        data_str = self.__data.strftime("%d/%m/%Y %H:%M")
        return (f"ID: {self.__id} | Data: {data_str} | "
                f"Distância: {self.__distancia:.2f} km | Tempo: {self.__tempo} | "
                f"Pace: {minutos:02d}:{segundos:02d} min/km")


class TreinoUI:
    def __init__(self):
        self.__treinos = []

    def menu(self) -> int:
        print("\n--- MENU TREINO ---")
        print("1 - Inserir novo treino")
        print("2 - Listar todos os treinos")
        print("3 - Listar treino por ID")
        print("4 - Atualizar treino")
        print("5 - Excluir treino")
        print("6 - Treino mais rápido")
        print("0 - Sair do Menu Treino")
        try:
            return int(input("Escolha uma opção: "))
        except ValueError:
            return -1

    def main(self):
        op = -1
        while op != 0:
            op = self.menu()
            if op == 1:
                self.inserir()
            elif op == 2:
                self.listar()
            elif op == 3:
                self.listar_id()
            elif op == 4:
                self.atualizar()
            elif op == 5:
                self.excluir()
            elif op == 6:
                self.mais_rapido()
            elif op == 0:
                print("Encerrando módulo Treino...")
            else:
                print("Opção inválida!")

    def inserir(self):
        try:
            id_t = int(input("ID: "))
            data_str = input("Data e Hora (dd/mm/aaaa hh:mm): ")
            dt = datetime.strptime(data_str, "%d/%m/%Y %H:%M")
            dist = float(input("Distância (km): "))
            horas = int(input("Tempo - Horas: "))
            minutos = int(input("Tempo - Minutos: "))
            segundos = int(input("Tempo - Segundos: "))
            tempo = timedelta(hours=horas, minutes=minutos, seconds=segundos)

            novo_treino = Treino(id_t, dt, dist, tempo)
            self.__treinos.append(novo_treino)
            print("Treino inserido com sucesso!")
        except Exception as e:
            print(f"Erro ao inserir treino: {e}")

    def listar(self):
        if not self.__treinos:
            print("Nenhum treino cadastrado.")
            return
        for t in self.__treinos:
            print(t)

    def listar_id(self):
        try:
            id_busca = int(input("Informe o ID do treino: "))
            for t in self.__treinos:
                if t.get_id() == id_busca:
                    print(t)
                    return
            print("Treino não encontrado.")
        except ValueError:
            print("ID inválido.")

    def atualizar(self):
        try:
            id_busca = int(input("Informe o ID do treino a atualizar: "))
            for t in self.__treinos:
                if t.get_id() == id_busca:
                    data_str = input("Nova Data e Hora (dd/mm/aaaa hh:mm): ")
                    dt = datetime.strptime(data_str, "%d/%m/%Y %H:%M")
                    dist = float(input("Nova Distância (km): "))
                    horas = int(input("Novo Tempo - Horas: "))
                    minutos = int(input("Novo Tempo - Minutos: "))
                    segundos = int(input("Novo Tempo - Segundos: "))
                    tempo = timedelta(hours=horas, minutes=minutos, seconds=segundos)

                    t.set_data(dt)
                    t.set_distancia(dist)
                    t.set_tempo(tempo)
                    print("Treino atualizado com sucesso!")
                    return
            print("Treino não encontrado.")
        except Exception as e:
            print(f"Erro ao atualizar: {e}")

    def excluir(self):
        try:
            id_busca = int(input("Informe o ID do treino a excluir: "))
            for t in self.__treinos:
                if t.get_id() == id_busca:
                    self.__treinos.remove(t)
                    print("Treino excluído com sucesso!")
                    return
            print("Treino não encontrado.")
        except ValueError:
            print("ID inválido.")

    def mais_rapido(self):
        if not self.__treinos:
            print("Nenhum treino cadastrado.")
            return
        mais_rapido = min(self.__treinos, key=lambda t: t.pace())
        print("--- Treino Mais Rápido (Menor Pace) ---")
        print(mais_rapido)


